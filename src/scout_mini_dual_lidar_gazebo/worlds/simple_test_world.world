<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="simple_test_world">
    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- Scene settings -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Load sensors system for LiDAR and other sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <rendering>true</rendering>
      <sensor_update_rate>10</sensor_update_rate>
    </plugin>

    <!-- Scene Broadcaster for sensor data distribution -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- User Commands for model manipulation -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.001 0 0 0</pose>
      <link name="ground">
        <collision name="ground_plane_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <ode2>
                  <mu2>100</mu2>
                </ode2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_plane_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -0.5</direction>
    </light>

    <!-- Obstacle Box 1 - Front of the robot -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>2.0 0.0 0.5 0 0 0</pose>
      <link name="obstacle_box_1_link">
        <collision name="obstacle_box_1_collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstacle_box_1_visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 2 - Left side -->
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>0.0 2.0 0.3 0 0 0</pose>
      <link name="obstacle_box_2_link">
        <collision name="obstacle_box_2_collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstacle_box_2_visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 3 - Right side -->
    <model name="obstacle_box_3">
      <static>true</static>
      <pose>0.0 -2.0 0.8 0 0 0</pose>
      <link name="obstacle_box_3_link">
        <collision name="obstacle_box_3_collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstacle_box_3_visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Box 4 - Behind the robot -->
    <model name="obstacle_box_4">
      <static>true</static>
      <pose>-2.0 0.0 0.4 0 0 0</pose>
      <link name="obstacle_box_4_link">
        <collision name="obstacle_box_4_collision">
          <geometry>
            <box>
              <size>0.8 2.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="obstacle_box_4_visual">
          <geometry>
            <box>
              <size>0.8 2.0 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.2 1</ambient>
            <diffuse>0.8 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
