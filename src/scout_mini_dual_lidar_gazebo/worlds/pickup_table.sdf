<?xml version="1.0" ?>
<!--
  Stage 5: Pickup table for the pick-and-place demo.

  Spawned at runtime by iot_deployment_launch.py at world (0.4, 0, 0)
  so it sits directly in front of the robot (which starts at the origin).
  The IoT device is spawned on top at (0.4, 0, 0.5), i.e. resting on the
  tabletop surface at z = 0.5 m (matches pose_pick_above / pose_pick and
  shelf_height). Static prop with collision so the released device can
  rest on it; no plugins.

  Tabletop 0.6 x 0.4 m, top surface at z = 0.5 m, four legs.
-->
<sdf version="1.9">
  <model name="pickup_table">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Tabletop: top surface at 0.5 m, board thickness 0.04 m -->
    <link name="tabletop">
      <pose>0 0 0.48 0 0 0</pose>
      <collision name="tabletop_collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="tabletop_visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.35 0.15 1</ambient>
          <diffuse>0.55 0.35 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Four legs: 0.46 m tall, top meeting underside of tabletop -->
    <link name="leg_fl">
      <pose>0.25 0.15 0.23 0 0 0</pose>
      <collision name="leg_fl_collision">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
      </collision>
      <visual name="leg_fl_visual">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="leg_fr">
      <pose>0.25 -0.15 0.23 0 0 0</pose>
      <collision name="leg_fr_collision">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
      </collision>
      <visual name="leg_fr_visual">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="leg_rl">
      <pose>-0.25 0.15 0.23 0 0 0</pose>
      <collision name="leg_rl_collision">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
      </collision>
      <visual name="leg_rl_visual">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="leg_rr">
      <pose>-0.25 -0.15 0.23 0 0 0</pose>
      <collision name="leg_rr_collision">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
      </collision>
      <visual name="leg_rr_visual">
        <geometry><box><size>0.05 0.05 0.46</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
