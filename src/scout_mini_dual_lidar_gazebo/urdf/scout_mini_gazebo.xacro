<?xml version="1.0"?>

<robot name="scout_mini"
    xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="robot_namespace" default="/" />
    <xacro:arg name="mesh_prefix" default="package://scout_description" />

    <xacro:include filename="$(find scout_description)/urdf/scout_wheel_type1.xacro" />
    <xacro:include filename="$(find scout_description)/urdf/scout_wheel_type2.xacro" />

    <!-- Variables for Scout Mini -->
    <xacro:property name="M_PI" value="3.14159"/>
    <xacro:property name="mesh_prefix" value="$(arg mesh_prefix)" />

    <!-- Vehicle Geometries - Scout Mini dimensions -->
    <xacro:property name="base_x_size" value="0.650" />
    <xacro:property name="base_y_size" value="0.350" />
    <xacro:property name="base_z_size" value="0.180" />

    <xacro:property name="wheelbase" value="0.380" />
    <xacro:property name="track" value="0.520" />
    <xacro:property name="wheel_vertical_offset" value="-0.060" />

    <xacro:property name="wheel_length" value="0.100" />
    <xacro:property name="wheel_radius" value="0.145" />

    <!-- Base link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="${mesh_prefix}/meshes/base_link.dae" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.008" rpy="0 0 0" />
            <geometry>
                <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="0 0 ${base_z_size/6}" rpy="0 0 0" />
            <geometry>
                <box size="${base_x_size/6} ${base_y_size*1.65} ${base_z_size/3}"/>
            </geometry>
        </collision>
    </link>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <origin xyz="0 0 ${wheel_vertical_offset - wheel_radius}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="base_footprint" />
    </joint>

    <link name="inertial_link">
        <inertial>
            <mass value="25" />
            <origin xyz="0.0 0.0 0.0" />
            <inertia ixx="0.323" ixy="0" ixz="0" iyy="0.948" iyz="0" izz="1.135" />
        </inertial>
    </link>

    <joint name="inertial_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="inertial_link" />
    </joint>

    <!-- 4-wheel direct drive (no mimic) -->
    <!-- All wheels share same axis "0 -1 0" (Y-axis). -->
    <!-- collision_rpy rotates cylinder from vertical to horizontal to match wheel shape. -->
    <xacro:scout_wheel_type1 wheel_prefix="front_left" axis_xyz="0 -1 0" collision_rpy="1.5708 0 0">
        <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
    </xacro:scout_wheel_type1>
    <xacro:scout_wheel_type2 wheel_prefix="front_right" axis_xyz="0 -1 0" collision_rpy="1.5708 0 0">
        <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
    </xacro:scout_wheel_type2>
    <xacro:scout_wheel_type1 wheel_prefix="rear_left" axis_xyz="0 -1 0" collision_rpy="1.5708 0 0">
        <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
    </xacro:scout_wheel_type1>
    <xacro:scout_wheel_type2 wheel_prefix="rear_right" axis_xyz="0 -1 0" collision_rpy="1.5708 0 0">
        <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
    </xacro:scout_wheel_type2>

    <!-- Front LiDAR (RS-AIRY) -->
    <link name="front_lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.04" />
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.04" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>

    <joint name="front_lidar_joint" type="fixed">
        <origin xyz="${base_x_size/2 - 0.08} 0.0 ${base_z_size/2 + 0.05}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="front_lidar_link" />
    </joint>

    <!-- Rear LiDAR (RS-AIRY) -->
    <link name="rear_lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.04" />
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder length="0.05" radius="0.04" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>

    <joint name="rear_lidar_joint" type="fixed">
        <origin xyz="${-base_x_size/2 + 0.08} 0.0 ${base_z_size/2 + 0.05}" rpy="0 0 3.14159" />
        <parent link="base_link" />
        <child link="rear_lidar_link" />
    </joint>

    <!-- Gazebo differential drive plugin -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_right_wheel</left_joint>
            <left_joint>rear_right_wheel</left_joint>
            <right_joint>front_left_wheel</right_joint>
            <right_joint>rear_left_wheel</right_joint>
            <wheel_separation>${track}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <max_wheel_torque>20</max_wheel_torque>
            <max_linear_acceleration>1.0</max_linear_acceleration>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <max_linear_velocity>2.0</max_linear_velocity>
            <max_angular_velocity>3.0</max_angular_velocity>
        </plugin>
    </gazebo>

    <!-- Gazebo joint state publisher -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>
    </gazebo>

    <!-- Front LiDAR Gazebo sensor plugin -->
    <gazebo reference="front_lidar_link">
        <sensor name="front_lidar_sensor" type="gpu_ray">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>5</update_rate>
            <always_on>true</always_on>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>25.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <topic>/front/scan</topic>
        </sensor>
    </gazebo>

    <!-- Rear LiDAR Gazebo sensor plugin -->
    <gazebo reference="rear_lidar_link">
        <sensor name="rear_lidar_sensor" type="gpu_ray">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>5</update_rate>
            <always_on>true</always_on>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>25.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <topic>/rear/scan</topic>
        </sensor>
    </gazebo>

</robot>
