    <child
      link="link7" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="0"
      upper="0.035"
      effort="10"
      velocity="1" />
  </joint>
  <link
    name="link8">
    <inertial>
      <origin
        xyz="0.000651231850419722 -0.0491929869131991 0.00972258769184024"
        rpy="0 0 0" />
      <mass
        value="0.025" />
      <inertia
        ixx="0.00007371"
        ixy="-0.00000113"
        ixz="0.00000021"
        iyy="0.00000781"
        iyz="-0.00001372"
        izz="0.0000747" />
    </inertial>
    <visual>
      <origin
